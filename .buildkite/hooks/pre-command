#!/usr/bin/env bash
# Copyright (c) 2026-present, Elastic NV
#
# Strict mirror of elastic/synthetics-recorder/.buildkite/hooks/pre-command,
# minus the nvm install (we install bun in build-and-package.sh on demand).
#
# Buildkite auto-masks env vars whose name ends with _SECRET or _TOKEN.

set -eo pipefail

# Only run for the elastic-ramen-release pipeline; agents may be shared.
if [[ "${BUILDKITE_PIPELINE_SLUG:-}" != "elastic-ramen-release" ]]; then
  return 0
fi

BUILDKITE_TOKEN_SECRET=$(vault kv get -field=buildkite_token kv/ci-shared/observability-ci/buildkite-read-build-access)
export BUILDKITE_TOKEN_SECRET

# Tagged releases run for real; everything else is a dry-run.
DRY_RUN=true
if [[ -n "${BUILDKITE_TAG:-}" ]]; then
  DRY_RUN=false
fi
export DRY_RUN

# Skip the GH token export when the running command is a pipeline upload —
# the dynamic-step generator (download-signed-artifacts.sh) doesn't need
# GH access. Matches synthetics-recorder.
if [[ "${BUILDKITE_COMMAND:-}" =~ .*"upload".* ]]; then
  echo "Skipped pre-command when running the Upload pipeline"
else
  echo "~~~ Configure ephemeral GitHub token"
  GITHUB_TOKEN=${VAULT_GITHUB_TOKEN:-}
  GH_TOKEN=${VAULT_GITHUB_TOKEN:-}
  export GH_TOKEN GITHUB_TOKEN
fi
