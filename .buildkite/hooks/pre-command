#!/usr/bin/env bash
# Copyright (c) 2026-present, Elastic NV
#
# Pre-command hook for the elastic-ramen-release Buildkite pipeline.
# Loads the BK API token used by .buildkite/scripts/download-signed-artifacts.sh
# to look up `triggered_build.id` per sign-* step. GitHub access for the
# build / create-release steps is provided by the
# `elastic/vault-github-token` plugin attached to those steps directly,
# not by this hook.
#
# Buildkite auto-masks env vars whose name ends with _SECRET or _TOKEN.

set -eo pipefail

# Only run for the elastic-ramen-release pipeline; agents may be shared.
# Pre-command hooks are sourced; `return 0` is the correct early-exit
# (`exit 0` actually breaks env loading on subsequent steps — confirmed
# in elastic/synthetics-recorder/.buildkite/hooks/pre-command and PR #58
# discussion r3147964816).
if [[ "${BUILDKITE_PIPELINE_SLUG:-}" != "elastic-ramen-release" ]]; then
  return 0
fi

BUILDKITE_TOKEN_SECRET=$(vault kv get -field=buildkite_token kv/ci-shared/observability-ci/buildkite-read-build-access)
export BUILDKITE_TOKEN_SECRET

# Tagged releases run for real; everything else is a dry-run.
DRY_RUN=true
if [[ -n "${BUILDKITE_TAG:-}" ]]; then
  DRY_RUN=false
fi
export DRY_RUN
