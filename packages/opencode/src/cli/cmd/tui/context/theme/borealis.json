{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#050F21",
    "darkBgPanel": "#0B1628",
    "darkBgElement": "#081B33",
    "darkFgBold": "#E3E8F2",
    "darkFg": "#CAD3E2",
    "darkMuted": "#8B9CBB",
    "darkDim": "#516381",
    "darkPrimary": "#61A2FF",
    "darkSecondary": "#EE72A6",
    "darkAccent": "#16C5C0",
    "darkCode": "#B386F9",
    "darkSuccess": "#24C292",
    "darkWarning": "#FCD883",
    "darkError": "#EE4C48",
    "darkInfo": "#B5E5F2",
    "darkBorder": "#2B394F",
    "darkBorderActive": "#485975",

    "lightBg": "#FFFFFF",
    "lightBgPanel": "#F6F9FC",
    "lightBgElement": "#E8F1FF",
    "lightFg": "#1D2A3E",
    "lightMuted": "#516381",
    "lightDim": "#98A8C3",
    "lightPrimary": "#1750BA",
    "lightSecondary": "#128D91",
    "lightAccent": "#BC1E70",
    "lightCode": "#6B3C9F",
    "lightSuccess": "#24C292",
    "lightWarning": "#FFBA00",
    "lightError": "#FA050C",
    "lightInfo": "#0F658A",
    "lightBorder": "#CAD3E2",
    "lightBorderActive": "#1750BA"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkInfo", "light": "lightInfo" },
    "text": { "dark": "darkFg", "light": "lightFg" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkBgPanel", "light": "lightBgPanel" },
    "backgroundElement": { "dark": "darkBgElement", "light": "lightBgElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorder", "light": "lightBorder" },
    "diffAdded": { "dark": "darkSuccess", "light": "lightSuccess" },
    "diffRemoved": { "dark": "darkSecondary", "light": "lightSecondary" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkDim", "light": "lightDim" },
    "diffHighlightAdded": { "dark": "#00E672", "light": "#52E0B5" },
    "diffHighlightRemoved": { "dark": "#F68F88", "light": "#F07875" },
    "diffAddedBg": { "dark": "#092A26", "light": "#C9F3E3" },
    "diffRemovedBg": { "dark": "#351721", "light": "#FDDDD8" },
    "diffContextBg": { "dark": "darkBgPanel", "light": "lightBgPanel" },
    "diffLineNumber": { "dark": "darkDim", "light": "lightDim" },
    "diffAddedLineNumberBg": { "dark": "#092A26", "light": "#C9F3E3" },
    "diffRemovedLineNumberBg": { "dark": "#351721", "light": "#FDDDD8" },
    "markdownText": { "dark": "darkFg", "light": "lightFg" },
    "markdownHeading": { "dark": "darkAccent", "light": "lightAccent" },
    "markdownLink": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLinkText": { "dark": "darkInfo", "light": "lightInfo" },
    "markdownCode": { "dark": "darkCode", "light": "lightCode" },
    "markdownBlockQuote": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownEmph": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownStrong": { "dark": "darkFgBold", "light": "lightMuted" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkSecondary", "light": "lightSecondary" },
    "markdownImage": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImageText": { "dark": "darkInfo", "light": "lightInfo" },
    "markdownCodeBlock": { "dark": "darkFg", "light": "lightFg" },
    "syntaxComment": { "dark": "darkDim", "light": "lightDim" },
    "syntaxKeyword": { "dark": "darkAccent", "light": "lightAccent" },
    "syntaxFunction": { "dark": "#ffffff", "light": "lightPrimary" },
    "syntaxVariable": { "dark": "darkMuted", "light": "lightFg" },
    "syntaxString": { "dark": "darkSuccess", "light": "lightSuccess" },
    "syntaxNumber": { "dark": "darkSecondary", "light": "lightSecondary" },
    "syntaxType": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxOperator": { "dark": "darkDim", "light": "lightDim" },
    "syntaxPunctuation": { "dark": "darkDim", "light": "lightDim" }
  }
}
